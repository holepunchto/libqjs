+static void js_abuf_track(JSRuntime *rt, JSArrayBuffer *abuf, size_t bytes)
+{
+    abuf->tracked_bytes = bytes;
+    rt->ab_malloc_size += bytes;
+}
+
+static void js_abuf_untrack(JSRuntime *rt, JSArrayBuffer *abuf)
+{
+    assert(rt->ab_malloc_size >= abuf->tracked_bytes);
+    rt->ab_malloc_size -= abuf->tracked_bytes;
+    abuf->tracked_bytes = 0;
+}
